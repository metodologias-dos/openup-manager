<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="using:OpenUpMan.Domain"
        x:Class="OpenUpMan.UI.Views.IterationCreateWindow"
        mc:Ignorable="d"
        Width="500" Height="360" CanResize="False" WindowStartupLocation="CenterOwner">
  <Border Padding="12">
    <StackPanel Spacing="8">
      <TextBlock FontSize="16" FontWeight="SemiBold">Crear nueva Iteración</TextBlock>

      <!-- Show phase names using an ItemTemplate -->
      <ComboBox x:Name="PhaseCombo">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="domain:Phase">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBox x:Name="NameBox" Watermark="Nombre de la iteración" />

      <TextBox x:Name="GoalBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Watermark="Objetivo breve / descripción"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <DatePicker x:Name="StartDatePicker"/>
        <DatePicker x:Name="EndDatePicker"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancelar" Click="OnCancel"/>
        <Button Content="Crear" Click="OnCreate"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
