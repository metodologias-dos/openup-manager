<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUpMan.UI.ViewModels"
             xmlns:domain="using:OpenUpMan.Domain"
             xmlns:labs="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:ic="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
             x:Class="OpenUpMan.UI.Views.ProjectView"
             x:DataType="vm:ProjectViewModel"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600">
    <StackPanel Orientation="Vertical" Spacing="12">
      <!-- Header: Project name + buttons -->
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
          <TextBox Width="300" 
                   Watermark="Nombre Proyecto Actual" 
                   Text="{Binding ProjectName}"/>
          <Button Content="Guardar" 
                  Command="{Binding SaveCommand}"/>
          <Button Content="Abrir" 
                  Command="{Binding OpenCommand}"/>
          <Button Content="Agregar usuario" 
                  Command="{Binding AddUserCommand}"/>
          <Button Content="Tablero" 
                  Command="{Binding OpenDashboardCommand}"/>
          <TextBlock VerticalAlignment="Center" 
                     Margin="16,0,0,0"
                     Text="{Binding ProjectPercentage, StringFormat='Porcentaje: {0}%'}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="2" HorizontalAlignment="Right">
          <Button Content="Volver" 
                  Command="{Binding BackCommand}"/>
        </StackPanel>
      </Grid>

      <!-- Stage buttons (notebook-like) -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Incepción" 
                Command="{Binding SelectPhaseCommand}" 
                CommandParameter="Inicio (Inception)"/>
        <Button Content="Elaboración" 
                Command="{Binding SelectPhaseCommand}" 
                CommandParameter="Elaboración (Elaboration)"/>
        <Button Content="Construcción" 
                Command="{Binding SelectPhaseCommand}" 
                CommandParameter="Construcción (Construction)"/>
        <Button Content="Transición" 
                Command="{Binding SelectPhaseCommand}" 
                CommandParameter="Transición (Transition)"/>
      </StackPanel>

      <!-- Main content area -->
      <Grid ColumnDefinitions="2*,1*" RowDefinitions="Auto" Height="600">
        <!-- Left large panel -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="1" 
                Margin="4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4">
          <StackPanel Margin="12">
            <!-- Placeholder for phase details and artifacts -->
            <TextBlock FontWeight="SemiBold" 
                       FontSize="16" 
                       Margin="0,0,0,12">Detalles de fase</TextBlock>
            <WrapPanel>
              <StackPanel Width="300" Spacing="4">
                <TextBlock>Fecha de Inicio:</TextBlock>
                <TextBlock>Fecha de Fin:</TextBlock>
                <TextBlock>Objetivo general:</TextBlock>
                <TextBlock>Alcance:</TextBlock>
              </StackPanel>

              <StackPanel Margin="16,0,0,0" Spacing="4">
                <TextBlock>Porcentaje de fase: 50%</TextBlock>
                <TextBlock Margin="0,8,0,4">Estado de la fase:</TextBlock>
                <ComboBox Width="150">
                  <ComboBoxItem Content="No iniciada"/>
                  <ComboBoxItem Content="En progreso"/>
                  <ComboBoxItem Content="Finalizada"/>
                </ComboBox>

                <TextBlock Margin="0,8,0,0">Acceso: Edición</TextBlock>
              </StackPanel>

              <StackPanel Margin="16,0,0,0" Width="250" Spacing="4">
                <TextBlock>Observaciones de fase:</TextBlock>
                <TextBox Height="60" 
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
                <Button Content="Manejar artefactos" 
                        Margin="0,8,0,0"
                        Command="{Binding ManageArtifactsCommand}"/>
              </StackPanel>

            </WrapPanel>

            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,20,0,0">
              <TextBlock Grid.Row="0"
                         FontWeight="SemiBold" 
                         FontSize="16" 
                         Margin="0,0,0,12">Iteraciones y Microincrementos</TextBlock>
              
              <StackPanel Grid.Row="1" 
                          Orientation="Horizontal" 
                          HorizontalAlignment="Right" 
                          Margin="0,0,0,8">
                <Button Content="Nueva Iteración" 
                        Command="{Binding CreateIterationCommand}"/>
              </StackPanel>

              <!-- Column Headers -->
              <Border Grid.Row="2"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                      BorderThickness="1,1,1,0"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="4,4,0,0"
                      Padding="8,12">
                <Grid ColumnDefinitions="200,150,100,120">
                  <TextBlock Grid.Column="0" 
                             Text="ITERACIÓN / MICROINCREMENTO" 
                             FontWeight="SemiBold"
                             FontSize="11"
                             Foreground="#B0B0B0"/>
                  <TextBlock Grid.Column="1" 
                             Text="TIPO / FECHA INICIO" 
                             FontWeight="SemiBold"
                             FontSize="11"
                             Foreground="#B0B0B0"
                             Margin="8,0"/>
                  <TextBlock Grid.Column="2" 
                             Text="FECHA FIN" 
                             FontWeight="SemiBold"
                             FontSize="11"
                             Foreground="#B0B0B0"
                             Margin="8,0"/>
                  <TextBlock Grid.Column="3" 
                             Text="PROGRESO / AUTOR" 
                             FontWeight="SemiBold"
                             FontSize="11"
                             Foreground="#B0B0B0"
                             HorizontalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- TreeDataGrid for Iterations and Microincrements -->
              <Border Grid.Row="3"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                      BorderThickness="1,0,1,1" 
                      Padding="0" 
                      Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="0,0,4,4">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              Height="200">
                  <TreeView ItemsSource="{Binding Iterations}"
                            x:Name="IterationsTreeView">
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate ItemsSource="{Binding Microincrements}">
                        <Border Padding="4,8" 
                                Background="Transparent"
                                CornerRadius="4">
                          <Grid ColumnDefinitions="200,150,100,120">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                              <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Calendar}" FontSize="16" Foreground="#4A9EFF"/>
                              <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Star}" 
                                               FontSize="12" 
                                               Foreground="#FFD700"
                                               IsVisible="{Binding IsActive}"
                                               ToolTip.Tip="Iteración activa"/>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding Name}" 
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                  <TextBlock Text="(ACTIVA)" 
                                             FontWeight="Bold"
                                             FontSize="10"
                                             Foreground="#FFD700"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsActive}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Goal}" 
                                           FontSize="11"
                                           Foreground="#B0B0B0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="160"/>
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Margin="8,0"/>
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding EndDate, StringFormat='dd/MM/yyyy'}" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Margin="8,0"/>
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding CompletionPercentage, StringFormat={}{0}%}" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.DataTemplates>
                      <DataTemplate DataType="vm:MicroincrementItemViewModel">
                        <Border Padding="4,6" 
                                Background="#08FFFFFF"
                                CornerRadius="4"
                                Margin="20,2,0,2">
                          <Grid ColumnDefinitions="180,120,100,120,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                              <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Subtract}" FontSize="12" Foreground="#B0B0B0"/>
                              <TextBlock Text="{Binding Title}" 
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Padding="6,3"
                                    Margin="4,0"
                                    HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Type}" 
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding DateFormatted}" 
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#B0B0B0"
                                       Margin="4,0"/>
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding AuthorName}" 
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Margin="4,0"/>
                            <Button Grid.Column="4"
                                    Command="{Binding $parent[UserControl].((vm:ProjectViewModel)DataContext).PreviewArtifactCommand}"
                                    CommandParameter="{Binding ArtifactId}"
                                    IsVisible="{Binding HasArtifact}"
                                    Padding="6,4"
                                    FontSize="10"
                                    Margin="4,0">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Eye}" FontSize="12"/>
                                <TextBlock Text="Ver" FontSize="10"/>
                              </StackPanel>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </TreeView.DataTemplates>
                  </TreeView>
                </ScrollViewer>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Right panel - Artifacts -->
        <Border Grid.Column="1" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="1" 
                Margin="4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="12,12,12,8">
              <TextBlock FontWeight="SemiBold" 
                         FontSize="16" 
                         Margin="0,0,0,8">Artefactos de la Fase</TextBlock>
              <TextBlock Text="{Binding CurrentPhaseName}" 
                         FontSize="12" 
                         Foreground="#B0B0B0"
                         Margin="0,0,0,8"/>
            </StackPanel>

            <!-- DataGrid de Artefactos -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding PhaseArtifacts}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      RowHeight="50"
                      Margin="8,0,8,8"
                      BorderThickness="0"
                      Background="Transparent">

              <DataGrid.Styles>
                <Style Selector="DataGridCell">
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="8,4" />
                  <Setter Property="Background" Value="Transparent" />
                </Style>

                <Style Selector="DataGridCell TextBlock">
                  <Setter Property="Foreground" Value="White" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontSize" Value="12" />
                </Style>

                <Style Selector="DataGridRow">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="CornerRadius" Value="4" />
                  <Setter Property="Margin" Value="0,1" />
                </Style>

                <Style Selector="DataGridRow:nth-child(2n)">
                  <Setter Property="Background" Value="#08FFFFFF" />
                </Style>

                <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
                  <Setter Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  <Setter Property="Opacity" Value="0.6" />
                </Style>

                <Style Selector="DataGridColumnHeader">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Foreground" Value="White" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Padding" Value="8,12,8,8" />
                  <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                  <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
              </DataGrid.Styles>

              <DataGrid.Columns>
                <!-- Nombre -->
                <DataGridTemplateColumn Header="NOMBRE" Width="*" MinWidth="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="vm:ArtifactItemViewModel">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ArtifactType}" 
                                   FontSize="10"
                                   Foreground="#B0B0B0" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Obligatorio -->
                <DataGridTemplateColumn Header="REQ." Width="60" MinWidth="50">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="vm:ArtifactItemViewModel">
                      <TextBlock Text="{Binding MandatoryText}" 
                                 HorizontalAlignment="Center"
                                 FontSize="11" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Versión -->
                <DataGridTemplateColumn Header="VER." Width="60" MinWidth="50">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="vm:ArtifactItemViewModel">
                      <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                              CornerRadius="3"
                              Padding="6,3"
                              HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentVersion}" 
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Acciones -->
                <DataGridTemplateColumn Header="ACCIONES" Width="160" MinWidth="140">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="vm:ArtifactItemViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button Command="{Binding $parent[UserControl].((vm:ProjectViewModel)DataContext).RegisterArtifactChangeCommand}"
                                CommandParameter="{Binding}"
                                Padding="8,6"
                                FontSize="10"
                                CornerRadius="4"
                                ToolTip.Tip="Registrar cambio">
                          <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Edit}" FontSize="14" />
                        </Button>
                        <Button Command="{Binding $parent[UserControl].((vm:ProjectViewModel)DataContext).ViewArtifactHistoryCommand}"
                                CommandParameter="{Binding}"
                                Padding="8,6"
                                FontSize="10"
                                CornerRadius="4"
                                ToolTip.Tip="Ver historial">
                          <labs:SymbolIcon Symbol="{x:Static ic:Symbol.History}" FontSize="14" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

      </Grid>
    </StackPanel>
</UserControl>
