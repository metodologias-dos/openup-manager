<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUpMan.UI.ViewModels"
        xmlns:domain="using:OpenUpMan.Domain"
        xmlns:labs="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:ic="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
        x:Class="OpenUpMan.UI.Views.ProjectUsersManagementDialog"
        x:DataType="vm:ProjectUsersManagementViewModel"
        Width="600" Height="500"
        Title="Gestionar Equipo del Proyecto"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Gestionar Equipo" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,0,20">
            <!-- Buscador -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <AutoCompleteBox Watermark="Buscar usuario para agregar..."
                                 Text="{Binding UserSearchText}"
                                 ItemsSource="{Binding UserSearchResults}"
                                 SelectedItem="{Binding SelectedSearchUser}"
                                 ValueMemberBinding="{Binding Username}"
                                 FilterMode="None"
                                 MinimumPrefixLength="1">
                    <AutoCompleteBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddUserFromSearchCommand}" CommandParameter="{Binding SelectedSearchUser}" />
                    </AutoCompleteBox.KeyBindings>
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate DataType="domain:User">
                            <Button Command="{Binding $parent[Window].((vm:ProjectUsersManagementViewModel)DataContext).AddUserFromSearchCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Person}" FontSize="16"/>
                                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
            </Grid>

            <!-- Lista de Usuarios -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding ProjectUsers}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" Width="*"/>
                    <DataGridTemplateColumn Header="ROL" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding SelectedRole}"
                                          DisplayMemberBinding="{Binding Name}"
                                          HorizontalAlignment="Stretch"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ACCIONES" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[Window].((vm:ProjectUsersManagementViewModel)DataContext).RemoveUserCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center">
                                    <labs:SymbolIcon Symbol="{x:Static ic:Symbol.Delete}" Foreground="#E81123"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Guardar Cambios" 
                    Command="{Binding SaveUsersCommand}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="#0078D4"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#106EBE"/>
                    </Style>
                    <Style Selector="Button:pressed">
                        <Setter Property="Background" Value="#005A9E"/>
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>
    </Grid>
</Window>
